# ╔══════════════════════════════════════════════════════════════╗
# ║  MacroMate – Environment Variables                         ║
# ║  Kopiere diese Datei als .env und passe die Werte an.      ║
# ║  cp .env.example .env                                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Umgebung ──────────────────────────────────────────────────
# "develop" | "test" | "production"
APP_ENV=develop

# ── Datenbank (PostgreSQL) ────────────────────────────────────
# Überschreibt das automatische DB-Mapping je APP_ENV.
# Format: postgresql://user:password@host:5432/dbname
# Lokal:  postgresql://macromate:macromate@localhost:5432/macromate_dev
# Neon:   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/macromate?sslmode=require
DATABASE_URL=

# ── Sicherheit ────────────────────────────────────────────────
# MUSS in production gesetzt werden! Generiere z.B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── AI / APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Komma-getrennte Liste erlaubter Origins.
# In Production: https://deine-domain.com
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# ── Premium-User Emails ──────────────────────────────────────
# Komma-getrennt; werden beim Startup automatisch premium gesetzt.
PREMIUM_EMAILS=lukas.hufnagl02@gmail.com
